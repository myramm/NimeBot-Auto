# Telegram API Credentials (from my.telegram.org)
API_ID=your_api_id
API_HASH=your_api_hash

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_bot_token

# Target Channel ID to upload anime files
LOG_CHANNEL=-100xxxxxxxxxx

# Web Streamer URL
STREAMER_URL=https://your-streamer-domain.up.railway.app

# Optional Owner / Admin ID
ADMIN_USER_ID=6164710787

# Scraper Settings (Optional)
SCRAPER_BASE_URL=https://xyz-api.animein.net
SCRAPER_APK_VER=5.2.2
SCRAPER_USER_AGENT=okhttp/4.12.0
